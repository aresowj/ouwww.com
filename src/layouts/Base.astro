---
const { title = "weijie ou's scratch pad", description = 'writing and tech sharing from a backend engineer', image, imageAlt = title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const googleAnalyticsId = 'G-2DKJ0LTKTJ';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const ogImage = image ? new URL(image, Astro.site) : null;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="article" />{ogImage && <><meta property="og:image" content={ogImage} /><meta property="og:image:alt" content={imageAlt} /><meta name="twitter:card" content="summary_large_image" /></>}<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/" />{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}<link rel="dns-prefetch" href="//www.googletagmanager.com" /><script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script><script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {{ window.dataLayer.push(arguments); }}
  gtag("set", "linker", {"domains": ["aresou.net"]});
  gtag("js", new Date());
  gtag("set", "developer_id.dZTNiMT", true);
  gtag("config", "G-2DKJ0LTKTJ");
</script></head><body><header><a href="/">weijie ou's scratch pad</a><nav><a href="/">Home</a><a href="/category/tech/">Tech</a><a href="/category/thoughts/">Thoughts</a><a href="/category/life/">Life</a><a href="/feed/">RSS</a></nav></header><main><slot /></main><footer>© {new Date().getFullYear()} weijie ou · <a href="/privacy-policy/">Privacy</a></footer></body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap'); :root{--ink:#243b53;--heading:#334e68;--muted:#627d98;--link:#486581;--accent:#829ab1;--page:#f4f7fa;--surface:#fff;--border:#d9e2ec;--code:#243b53;--code-ink:#f0f4f8;font-family:Barlow,system-ui,sans-serif;color:var(--ink);background:var(--page);line-height:1.65}body{margin:0}header,main,footer{max-width:860px;margin:auto;padding:1.25rem}header{display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid var(--border)}header>a{font-weight:700;color:var(--heading);text-decoration:none;font-size:1.2rem}nav{display:flex;gap:1rem;flex-wrap:wrap}a{color:var(--link)}main{padding-top:3rem;min-height:70vh}article{background:var(--surface);padding:clamp(1.2rem,4vw,3rem);box-shadow:0 8px 32px #243b5310}h1{font-size:clamp(2rem,6vw,3.2rem);line-height:1.1;color:var(--heading)}h2{color:var(--heading)}pre{overflow-x:auto;background:var(--code);color:var(--code-ink);padding:1rem;border-radius:4px}code{background:#e8eef3;padding:.15rem .3rem;border-radius:3px}pre code{background:none;padding:0}.hljs-comment{color:#9fb3c8}.hljs-keyword,.hljs-selector-tag{color:#d9a38f}.hljs-string,.hljs-attr{color:#b8d8c0}.hljs-number,.hljs-literal{color:#b3d4f5}.hljs-title,.hljs-built_in{color:#e6c98f}img{max-width:100%;height:auto}.post-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.card{background:var(--surface);padding:0;border-top:4px solid var(--accent);overflow:hidden}.card-cover{display:block;aspect-ratio:16/9;overflow:hidden;background:#e8eef3}.card-cover img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .2s ease}.card-cover:hover img{transform:scale(1.03)}.card-body{padding:1.4rem}.meta{color:var(--muted)}footer{border-top:1px solid var(--border);color:var(--muted)}@media (max-width:700px){.post-list{grid-template-columns:1fr}}
</style>
