---
const { title = "weijie ou's scratch pad", description = 'writing and tech sharing from a backend engineer' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const googleAnalyticsId = 'G-2DKJ0LTKTJ';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:type" content="article" /><link rel="alternate" type="application/rss+xml" title="RSS" href="/feed/" />{googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}<link rel="dns-prefetch" href="//www.googletagmanager.com" /><script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}></script><script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {{ window.dataLayer.push(arguments); }}
  gtag("set", "linker", {"domains": ["aresou.net"]});
  gtag("js", new Date());
  gtag("set", "developer_id.dZTNiMT", true);
  gtag("config", "G-2DKJ0LTKTJ");
</script></head><body><header><a href="/">weijie ou's scratch pad</a><nav><a href="/">Home</a><a href="/category/tech/">Tech</a><a href="/category/thoughts/">Thoughts</a><a href="/category/life/">Life</a><a href="/feed/">RSS</a></nav></header><main><slot /></main><footer>© {new Date().getFullYear()} weijie ou · <a href="/privacy-policy/">Privacy</a></footer></body></html>
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap'); :root{font-family:Barlow,system-ui,sans-serif;color:#24313d;background:#f7f8fa;line-height:1.65}body{margin:0}header,main,footer{max-width:860px;margin:auto;padding:1.25rem}header{display:flex;justify-content:space-between;gap:1rem;align-items:center;border-bottom:1px solid #dbe2e8}header>a{font-weight:700;color:#0e7080;text-decoration:none;font-size:1.2rem}nav{display:flex;gap:1rem;flex-wrap:wrap}a{color:#087f8c}main{padding-top:3rem;min-height:70vh}article{background:#fff;padding:clamp(1.2rem,4vw,3rem);box-shadow:0 8px 32px #19324a0d}h1{font-size:clamp(2rem,6vw,3.2rem);line-height:1.1}h2{color:#086c78}pre{overflow-x:auto;background:#15232e;color:#e8f1f5;padding:1rem;border-radius:4px}code{background:#eef3f5;padding:.15rem .3rem;border-radius:3px}pre code{background:none;padding:0}.hljs-comment{color:#8299a6}.hljs-keyword,.hljs-selector-tag{color:#ff9d76}.hljs-string,.hljs-attr{color:#b8e986}.hljs-number,.hljs-literal{color:#a9d4ff}.hljs-title,.hljs-built_in{color:#f6d365}img{max-width:100%;height:auto}.post-list{display:grid;gap:1rem}.card{background:white;padding:1.4rem;border-left:4px solid #18a0ae}.meta{color:#687986}footer{border-top:1px solid #dbe2e8;color:#687986}
</style>
