---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const terms = [...new Set(posts.map((post) => post.data.categories[0].toLowerCase()))];
  return terms.map((term) => ({
    params: { term },
    props: { term, posts: posts.filter((post) => post.data.categories[0].toLowerCase() === term) },
  }));
}

const { term, posts } = Astro.props;
---

<Base title={`${term} · weijie ou's scratch pad`}>
  <h1>{term}</h1>
  <section class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </section>
</Base>
