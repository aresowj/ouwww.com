---
import { getCollection } from 'astro:content'; import Base from '../../layouts/Base.astro'; import { formatPostDate } from '../../lib/dates.js';
export async function getStaticPaths(){const posts=await getCollection('blog'); const terms=[...new Set(posts.flatMap(p=>p.data.categories.slice(1).map(t=>t.toLowerCase().replaceAll(' ','-'))))]; return terms.map(term=>({params:{term},props:{term,posts:posts.filter(p=>p.data.categories.slice(1).some(t=>t.toLowerCase().replaceAll(' ','-')===term))}}));}
const {term,posts}=Astro.props;
---
<Base title={`#${term} · weijie ou's scratch pad`}><h1>#{term}</h1><section class="post-list">{posts.map(({data})=><article class="card"><div class="meta">{formatPostDate(data)}</div><h2><a href={`/${data.year}/${data.month}/${data.day}/${data.routeSlug}/`}>{data.title}</a></h2></article>)}</section></Base>
