---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro';
export async function getStaticPaths(){const posts=await getCollection('blog'); return posts.map(({data,body})=>({params:{slug:`${data.year}/${data.month}/${data.day}/${data.routeSlug}`},props:{data,body}}));}
const {data,body}=Astro.props;
---
<Base title={data.title}><article><div class="meta">{data.date.toLocaleDateString('en-US',{dateStyle:'long'})} · {data.categories.join(', ')}</div><h1>{data.title}</h1><div set:html={body} /></article></Base>
