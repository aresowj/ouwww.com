---
import { getCollection } from 'astro:content'; import Base from '../layouts/Base.astro'; import TableOfContents from '../components/TableOfContents.astro'; import { highlightArticle } from '../lib/highlight.js'; import { formatPostDate } from '../lib/dates.js';
export async function getStaticPaths(){const posts=await getCollection('blog'); return posts.map(({data,body})=>({params:{slug:`${data.year}/${data.month}/${data.day}/${data.routeSlug}`},props:{data,body}}));}
const {data,body}=Astro.props;
const headings = [...body.matchAll(/<h([23])>(.*?)<\/h\1>/g)].map((match) => ({ level: Number(match[1]), text: match[2].replace(/<[^>]+>/g, ''), id: match[2].toLowerCase().replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') }));
const articleWithIds = body.replace(/<h([23])>(.*?)<\/h\1>/g, (_match, level, text) => `<h${level} id="${text.toLowerCase().replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}">${text}</h${level}>`);
---
<Base title={data.title} description={data.description} image={data.cover} imageAlt={data.coverAlt}><article><div class="meta">{formatPostDate(data)} · {data.categories.join(', ')}</div><h1>{data.title}</h1>{data.toc && headings.length > 0 ? <TableOfContents items={headings} /> : null}<div set:html={highlightArticle(articleWithIds)} /></article></Base>
